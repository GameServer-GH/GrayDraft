# GrayDraft BFF 生产环境配置
APP_NAME=graydraft
APP_ENV=production
LOG_LEVEL=info

HTTP_PORT=8787

# GrayDraft Core 地址（Docker 内部网络）
GRAYDRAFT_CORE_URL=http://core:18080

# GrayDraft Model Gateway 地址（多模态/LLM 推理）
GRAYDRAFT_MODEL_GATEWAY_URL=http://gateway:18002

# Agent v2：与 Core 共用 JWT_SECRET，签发 agent_service token
JWT_SECRET=prod_jwt_secret_change_before_deploy
GRAYDRAFT_AGENT_ID=edu-tutor
GRAYDRAFT_AGENT_ACTOR_ID=graydraft-bff
GRAYDRAFT_AGENT_POLICY_VERSION=edu_workspace_v1

# 工作区数据目录
GRAYDRAFT_DATA_DIR=/data

# KB 类型前缀
GRAYDRAFT_KB_TYPE_PREFIX=gd_

# 系统级 LLM 凭证（无工作区时图片识别等 API 的回退方案）
# 支持 provider: deepseek / openai / zhipu / google
# Provider 与 Model 必须配置。API Key 留空时使用程序内加密密钥。
GRAYDRAFT_SYSTEM_LLM_PROVIDER=intern
GRAYDRAFT_SYSTEM_LLM_MODEL=internvl-latest
GRAYDRAFT_SYSTEM_LLM_API_KEY=

# HTTP 超时（秒）
GRAYDRAFT_HTTP_TIMEOUT_SEC=90
GRAYDRAFT_SMART_IMPORT_TIMEOUT_SEC=900
