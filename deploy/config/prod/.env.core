APP_NAME=graydraft-core
APP_ENV=production
LOG_LEVEL=info

HTTP_PORT=18080
GRPC_PORT=19090

DB_HOST=postgres
DB_PORT=5432
DB_USER=graydraft_admin
DB_PASSWORD=dev_password_123
DB_NAME=graydraft_kb
DB_SSLMODE=disable

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dev_redis_pass
REDIS_DB=0

NATS_URL=nats://nats:4222
NATS_JETSTREAM_ENABLED=true
NATS_STREAM=GRAYDRAFT_UGC
ANSWER_CACHE_ENABLED=true
METRICS_ENABLED=true

JWT_SECRET=prod_jwt_secret_change_before_deploy
ADMIN_USER=admin
ADMIN_PASSWORD=prod_admin_password_change_me

# 模型网关：向量和重排走百炼；规划 intern-s1-mini，回答 intern-s2。
# Key 加密在程序内，留空即用内置密钥；填写则覆盖。
DEEPSEEK_API_KEY=
INTERN_API_KEY=
INTERN_BASE_URL=https://chat.intern-ai.org.cn/api/v1
EMBEDDING_MODEL=text-embedding-v4
LLM_MODEL_FAST=intern-s1-mini
LLM_MODEL=intern-s2
RERANK_MODEL=qwen3-rerank

MODEL_GATEWAY_URL=http://gateway:18002
AI_WORKER_URL=http://worker:18001

# 视觉抽取走书生 internvl-latest。未单独设置时使用上面的 INTERN_API_KEY / INTERN_BASE_URL。
MULTIMODAL_BASE_URL=https://chat.intern-ai.org.cn/api/v1
MULTIMODAL_VL_MAX_MODEL=internvl-latest
MULTIMODAL_ENABLED=true

CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL=7200
