APP_NAME=graydraft-gateway
APP_ENV=development
LOG_LEVEL=debug
HTTP_PORT=18002

# DeepSeek 不再用于对话或重排。Key 加密在程序内，留空即用内置密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 书生：规划 intern-s1-mini（关闭思考），回答 intern-s2。
# Key 加密在程序内，留空即用内置密钥；填写则覆盖。
INTERN_API_KEY=
INTERN_BASE_URL=https://chat.intern-ai.org.cn/api/v1

# 百炼 DashScope：向量走兼容接口，重排走专用 text-rerank。
# Key 加密在程序内，留空即用内置密钥；填写则覆盖。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode

# 可在 YAML models.*.model 或环境变量覆盖模型名
EMBEDDING_MODEL=text-embedding-v4
LLM_MODEL_FAST=intern-s1-mini
LLM_MODEL=intern-s2
RERANK_MODEL=qwen3-rerank
EMBEDDING_PROVIDER=dashscope
LLM_PROVIDER=intern
RERANK_PROVIDER=dashscope

EMBEDDING_DIM=1024

# 可选：OpenAI 作为备用 provider
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
