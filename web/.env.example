# 复制为 .env.development / .env.production 或本地 .env.local 参考
# 仅 VITE_ 前缀会打入前端 bundle

# API 根 URL（无尾部斜杠）。开发留空 = 同域 /api + Vite 代理
VITE_API_BASE_URL=

# WebSocket 完整 URL
VITE_WS_URL=

# OSS / 静态资源 CDN 根 URL（无尾部斜杠）
VITE_OSS_BASE_URL=

# JWT 相关（前端可见；机密请放服务端）
VITE_JWT_KEY=

# 默认语言，如 zh-CN、en-US
VITE_DEFAULT_LOCALE=zh-CN

# 语言包规范与帮助页（站内路径或完整 URL）
VITE_LANGUAGE_PACK_HELP_URL=/language-pack-help.html
